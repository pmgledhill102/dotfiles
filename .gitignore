# Dotfiles managed by chezmoi

# Ignore local state
.chezmoi.yaml
.chezmoistate.boltdb

# Ignore secrets
.secrets

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore editor/IDE files
.vscode/
.idea/

# Project-local Claude Code settings (machine-specific permissions, never shared)
.claude/settings.local.json

# Claude Code scheduled-task lock file (created by Monitor / ScheduleWakeup tools)
.claude/scheduled_tasks.lock

# Ignore shell history
.zsh_history
.bash_history

# Ignore temporary files
temp/

# Ignore downloaded binaries at repo root (not nested bin/ dirs under home/)
/bin/

