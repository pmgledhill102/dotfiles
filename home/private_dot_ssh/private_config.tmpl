Host *.servers.pmgledhill.com
    User ubuntu
{{- /* Bitwarden serves a Unix socket on macOS and Linux (relayed into WSL,
       #451), but the named pipe \\.\pipe\openssh-ssh-agent on Windows, which
       is Windows OpenSSH's default. Pointing IdentityAgent at the socket there
       would bypass that pipe, so leave the line out on Windows (#463). */ -}}
{{- if ne .chezmoi.os "windows" }}
    IdentityAgent ~/.bitwarden-ssh-agent.sock
{{- end }}
    CheckHostIP no
    ServerAliveInterval 60
    ServerAliveCountMax 3

# Route ssh-to-github through port 443 via ssh.github.com.
# Some networks, Claude Code's sandbox among them, block outbound port 22 to
# GitHub, so git-over-SSH hangs on ~75s TCP timeouts. 443 is GitHub's official
# SSH-over-HTTPS endpoint and works everywhere.
# Docs: https://docs.github.com/en/authentication/troubleshooting-ssh/using-ssh-over-the-https-port
Host github.com
    Hostname ssh.github.com
    Port 443
    User git
