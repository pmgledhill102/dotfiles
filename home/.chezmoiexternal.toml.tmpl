# Mount agentic-coding-config's home/ subdirectory at ~/.claude/.
#
# We use chezmoi's `archive` external (downloading the GitHub-generated
# tarball) rather than `git-repo`, because git-repo externals mount the
# entire repo tree at the target with no filtering — .git/, .beads/,
# .github/, README, ADRs, all of it would flood ~/.claude/. Archive
# externals support stripComponents + include glob patterns, which lets
# only home/** deploy.
#
# Trade-off accepted: archive re-downloads on each refresh (vs git-repo's
# incremental fetch). For a repo this small that's fine; refreshPeriod
# bounds the frequency.
#
# stripComponents=2 strips both "agentic-coding-config-main/" (GitHub's
# auto-generated archive root) and "home/" so paths land directly under
# ~/.claude/. include filters out everything outside home/.
#
# personal-only: the agent config carries the personal-org GitHub workflow
# and personal-context-repo references, and the Claude binaries themselves
# are already gated to personal in Brewfile.tmpl. See dotfiles#389.
#
# On WSL, ~/.claude/CLAUDE.md comes from agentic-coding-config's WSL profile
# (profiles/claude-wsl/CLAUDE.md) rather than from home/, whose CLAUDE.md is
# the macOS profile. The archive's include is narrowed to skip home/CLAUDE.md
# (home/[!C]*: an `exclude` would let unmatched paths outside home/ through
# and collide), and an archive-file external delivers the profile. See #481.

{{- $machineType := "personal" -}}
{{- if hasKey . "machine_type" -}}
{{-   $machineType = .machine_type -}}
{{- end -}}
{{- /* WSL, per chezmoi's Windows/WSL guide. .chezmoi.kernel exists only on Linux. */ -}}
{{- $isWSL := false -}}
{{- if and (eq .chezmoi.os "linux") (hasKey .chezmoi "kernel") -}}
{{-   if .chezmoi.kernel.osrelease | lower | contains "microsoft" -}}
{{-     $isWSL = true -}}
{{-   end -}}
{{- end -}}
{{- $url := "https://github.com/pmgledhill102/agentic-coding-config/archive/refs/heads/main.tar.gz" -}}
{{- if eq $machineType "personal" }}
[".claude"]
type = "archive"
url = "{{ $url }}"
stripComponents = 2
refreshPeriod = "168h"
{{- if $isWSL }}
include = [
    "agentic-coding-config-main/home/[!C]*",
    "agentic-coding-config-main/home/[!C]*/**",
]

[".claude/CLAUDE.md"]
type = "archive-file"
url = "{{ $url }}"
path = "agentic-coding-config-main/profiles/claude-wsl/CLAUDE.md"
refreshPeriod = "168h"
{{- else }}
include = ["agentic-coding-config-main/home/**"]
{{- end }}
{{- end }}
