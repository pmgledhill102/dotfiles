#!/bin/bash
# setup-secrets — fetch development secrets from Bitwarden
# Runs once after chezmoi apply on personal machines only
# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"
set -euo pipefail

# {{ if ne .machine_type "personal" }}
echo "Not a personal machine — skipping secrets setup"
exit 0
# {{ end }}

# 1. Check bw CLI available. bw comes from Homebrew (macOS, and personal Linux
#    per ADR-0017). chezmoi inherits PATH from the shell that ran it, which
#    lacks Homebrew when Homebrew was installed by this same apply, so a fresh
#    machine would skip here and, this being run_once, never retry (#457).
for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
    if [ -x "$brew_bin" ]; then
        eval "$("$brew_bin" shellenv)"
        break
    fi
done
if ! command -v bw >/dev/null 2>&1; then
    echo "Bitwarden CLI not found — skipping secrets setup"
    exit 0
fi

# 2. Check if secrets already populated
if [ -f "$HOME/.secrets" ] && grep -q '[^[:space:]]' "$HOME/.secrets"; then
    echo "$HOME/.secrets already exists — skipping secrets setup"
    exit 0
fi

# 3. Prompt user (skip if not interactive)
if [ ! -t 0 ]; then
    echo "Non-interactive shell — skipping secrets setup"
    exit 0
fi

printf "Set up development secrets from Bitwarden? (y/n) "
read -r answer
if [ "$answer" != "y" ]; then
    echo "Skipping secrets setup"
    exit 0
fi

# 4. Get a session with as few master-password prompts as possible (#461).
#    Already unlocked (a valid BW_SESSION in the environment): none. Locked:
#    one, for unlock. Logged out: one, because `bw login --raw` returns the
#    session itself, so no separate unlock. A stale stored login passes
#    `bw login --check` but fails unlock against the server (invalid_grant);
#    then log out and log in once instead of crashing. --raw everywhere keeps
#    the session key off the terminal. The prompts go to the tty, not stdout.
bw_status=$(bw status 2>/dev/null | grep -o '"status":"[a-z]*"' | cut -d'"' -f4) || bw_status=
case "$bw_status" in
    unlocked) ;;
    locked)
        if ! BW_SESSION=$(bw unlock --raw); then
            echo "Unlock failed (stale login?) — logging in to Bitwarden again..."
            bw logout >/dev/null 2>&1 || true
            BW_SESSION=$(bw login --raw)
        fi
        ;;
    *)
        echo "Logging in to Bitwarden..."
        BW_SESSION=$(bw login --raw)
        ;;
esac
export BW_SESSION

# 5. Fetch secrets and write file
NOTES=$(bw get notes "dotfiles-secrets")
echo "$NOTES" > "$HOME/.secrets"
chmod 600 "$HOME/.secrets"
echo "Secrets written to ~/.secrets"

# Lock again so the session key stops working; nothing else needs it.
bw lock >/dev/null 2>&1 || true
