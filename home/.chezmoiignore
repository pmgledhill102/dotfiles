{{- if hasKey . "machine_type" -}}
{{-   $machineType = .machine_type -}}
{{- end -}}
.secrets

# .claude/* filtering is now handled by the archive external's `include`
# pattern in .chezmoiexternal.toml.tmpl — only agentic-coding-config's
# home/** deploys, so repo-meta (README, adrs/, .github/, .beads/, etc.)
# never reaches ~/.claude/. No per-target .chezmoiignore lines needed.

# Only apply PowerShell scripts on Windows
{{- if ne .chezmoi.os "windows" }}
run_once_install-packages-windows.ps1
install-packages-windows.ps1
run_once_setup-windows-environment.ps1
setup-windows-environment.ps1
run_once_install-vscode-extensions.ps1
install-vscode-extensions.ps1
run_after_prune-retired-claude-files.ps1
prune-retired-claude-files.ps1
AppData/
{{- end }}

# Only apply Unix files on Unix (ignore on Windows)
{{- if eq .chezmoi.os "windows" }}
run_once_install-packages.sh
install-packages.sh
run_once_macos_defaults.sh
macos_defaults.sh
run_once_after_install-brewfile.sh
install-brewfile.sh
run_onchange_after_install-npm-globals.sh
install-npm-globals.sh
run_once_remove-claude-code-cask.sh
remove-claude-code-cask.sh
run_once_migrate-tart-to-openai-tap.sh
migrate-tart-to-openai-tap.sh
run_once_after_disable-colima-autostart.sh
disable-colima-autostart.sh
run_once_remove-beads-dolt.sh
remove-beads-dolt.sh
# Windows has no /bin/sh, so chezmoi cannot exec this. A native-Windows work
# machine that applied the pre-gate external would therefore keep the config.
# Accepted gap, not an oversight: there are no native-Windows work machines in
# the estate, so there is nothing for it to clean up. The retired-file pruner
# it used to be grouped with *is* covered on Windows now, by
# run_after_prune-retired-claude-files.ps1 (#375) — the two gaps had opposite
# triggers (personal vs work machines) and only one of them was real.
run_once_remove-claude-config-nonpersonal.sh
remove-claude-config-nonpersonal.sh
run_onchange_install-ubuntu-packages.sh
install-ubuntu-packages.sh
run_once_configure-wsl.sh
configure-wsl.sh
run_once_install-vscode-extensions.sh
install-vscode-extensions.sh
Brewfile
.tmux.conf
run_onchange_setup-claude.sh
setup-claude.sh
run_after_prune-retired-claude-files.sh
prune-retired-claude-files.sh
run_once_after_setup-secrets.sh
setup-secrets.sh
{{- end }}

# Only apply Windows files on Windows (ignore on Unix)
{{- if ne .chezmoi.os "windows" }}
.config/winget-packages.json
{{- end }}


# OS-specific files
{{- if ne .chezmoi.os "darwin" }}
run_once_macos_defaults.sh
macos_defaults.sh
run_once_remove-claude-code-cask.sh
remove-claude-code-cask.sh
run_once_migrate-tart-to-openai-tap.sh
migrate-tart-to-openai-tap.sh
run_onchange_after_install-cship.sh
install-cship.sh
# macOS-only commands: xcodes and Tart VMs (dotfiles#439)
.config/zsh/functions/xcodeup.zsh
.local/bin/ci-vm-*
# Colima and Homebrew's Docker CLI plugins are macOS-only; Linux runs Docker
# Engine natively, with its plugins on the default path (ADR-0018)
run_once_after_disable-colima-autostart.sh
disable-colima-autostart.sh
.docker
.docker/**
{{- end }}

# Homebrew + Brewfile: macOS, and personal Linux machines (ADR-0017). Work and
# minimal Linux machines stay apt-only, so brewup is not deployed there.
{{- if not (or (eq .chezmoi.os "darwin") (and (eq .chezmoi.os "linux") (eq $machineType "personal"))) }}
run_once_after_install-brewfile.sh
install-brewfile.sh
Brewfile
.config/zsh/functions/brewup.zsh
{{- end }}

{{- if ne .chezmoi.os "linux" }}
run_onchange_install-ubuntu-packages.sh
install-ubuntu-packages.sh
run_once_configure-wsl.sh
configure-wsl.sh
.config/ubuntu_pkglist
{{- end }}

# Only deploy cloudcoop config on personal machines
# cship install script is macOS personal only
{{- if ne $machineType "personal" }}
.config/cloudcoop/
run_onchange_after_install-cship.sh
install-cship.sh
{{- end }}

# Don't apply the personal-identity ~/.gitconfig on work machines.
# Work machines manage their own git identity (corporate email, signing key, etc.)
# outside of these dotfiles.
{{- if eq $machineType "work" }}
.gitconfig
{{- end }}

# Skip GUI app configs on minimal/server machines
{{- if eq $machineType "minimal" }}
.config/Code/
.config/ghostty/
.config/vscode-extensions
run_once_install-vscode-extensions.sh
install-vscode-extensions.sh
run_once_install-vscode-extensions.ps1
install-vscode-extensions.ps1
{{- end }}
